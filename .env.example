# CJ Dropshipping API (required for products)
CJ_API_KEY=your_cj_api_key_here

# Admin portal (change before production — never use defaults)
ADMIN_USER=your_admin_username
ADMIN_PASSWORD=your_strong_password

# Server (NODE_ENV=production is set automatically on Render — see render.yaml)
NODE_ENV=development
PORT=3000

# Firebase Admin — product overrides in Firestore (optional; falls back to data/product-overrides.json)
# Paste the full service account JSON as one line, or use a file path:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
